# A few made-up example readings to check.
# (Includes negative and zero heart rate, like the real issue flagged
# in the Data Quality Assessment.)
sensor_type <- c("HeartRate", "HeartRate", "HeartRate", "SleepScore", "SleepScore", "PulseOx", "PulseOx")
value       <- c(68,          -4,          0,           82,           140,          97,        55)
cat("Sensor Plausibility Check — example run\n\n")
# Go through each reading one by one and check it.
for (i in 1:length(value)) {
type <- sensor_type[i]
v <- value[i]
# Work out the plausible range for this sensor type.
if (type == "HeartRate") {
low <- 30
high <- 220
} else if (type == "SleepScore") {
low <- 0
high <- 100
} else if (type == "PulseOx") {
low <- 70
high <- 100
}
# Check if the value falls inside that range.
if (v >= low & v <= high) {
cat(type, "-", v, "-> VALID\n")
} else {
cat(type, "-", v, "-> FLAGGED (outside", low, "to", high, ")\n")
}
}
cat("\nFlagged readings would be excluded from calculations but kept\n")
